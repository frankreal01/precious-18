DATABASE_URL="postgresql://user:pass@localhost:5432/precious18"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
RECIPIENT_COOKIE_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
# Local Docker S3Mock defaults. Replace with real credentials for cloud storage.
S3_ENDPOINT="http://localhost:9090"
S3_REGION="auto"
S3_BUCKET="precious-media"
S3_ACCESS_KEY="local-access-key"
S3_SECRET_KEY="local-secret-key"
